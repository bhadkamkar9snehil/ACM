# Normalize text files to LF by default so Git diffs stay stable across editors.
* text=auto eol=lf

# Keep Windows shell scripts in native CRLF format.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve common binary artifacts exactly as stored.
*.dll binary
*.exe binary
*.gif binary
*.ico binary
*.joblib binary
*.jpeg binary
*.jpg binary
*.npy binary
*.npz binary
*.pdf binary
*.pickle binary
*.pkl binary
*.png binary
*.so binary
*.zip binary
