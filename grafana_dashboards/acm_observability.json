{
  "annotations": { "list": [] },
  "description": "ACM Pipeline Observability — Runs, Resources (Prometheus), Traces (Tempo), Logs (Loki), Profiling (Pyroscope)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "PIPELINE RUN HISTORY",
      "type": "row"
    },
    {
      "datasource": { "type": "mssql", "uid": "mssql-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "OK": { "text": "OK", "color": "green", "index": 0 } } },
                { "type": "value", "options": { "ERROR": { "text": "ERROR", "color": "red", "index": 1 } } },
                { "type": "value", "options": { "PARTIAL": { "text": "PARTIAL", "color": "orange", "index": 2 } } }
              ]}
            ]
          },
          { "matcher": { "id": "byName", "options": "ProcessingTimeMs" }, "properties": [{ "id": "unit", "value": "ms" }] },
          { "matcher": { "id": "byName", "options": "RowsProcessed" }, "properties": [{ "id": "unit", "value": "short" }] }
        ]
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"] },
        "showHeader": true,
        "sortBy": [{ "displayName": "CreatedAt", "desc": true }]
      },
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "mssql-ds" },
          "format": "table",
          "rawSql": "SELECT TOP 30\n  eq.EquipCode AS Equipment,\n  rs.Status,\n  rs.RowsProcessed,\n  rs.EpisodesDetected,\n  rs.ProcessingTimeMs,\n  LEFT(rs.ConfigSignature, 12) AS Config,\n  CONVERT(varchar(19), rs.CreatedAt, 120) AS CreatedAt,\n  LEFT(ISNULL(rs.ErrorMessage, ''), 60) AS ErrorMessage\nFROM dbo.ACM_RunSummary rs\nJOIN dbo.Equipments eq ON eq.EquipID = rs.EquipID\nWHERE rs.CreatedAt BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY rs.CreatedAt DESC",
          "refId": "A"
        }
      ],
      "title": "Recent Pipeline Runs",
      "type": "table"
    },
    {
      "datasource": { "type": "mssql", "uid": "mssql-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 80 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 8 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "mssql-ds" },
          "format": "time_series",
          "rawSql": "SELECT COUNT(*) AS value FROM dbo.ACM_RunSummary WHERE CreatedAt BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "Total Runs",
      "type": "stat"
    },
    {
      "datasource": { "type": "mssql", "uid": "mssql-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 8 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "mssql-ds" },
          "format": "time_series",
          "rawSql": "SELECT COUNT(*) AS value FROM dbo.ACM_RunSummary WHERE Status = 'ERROR' AND CreatedAt BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "Failed Runs",
      "type": "stat"
    },
    {
      "datasource": { "type": "mssql", "uid": "mssql-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5000 }, { "color": "red", "value": 30000 }] },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 8 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "mssql-ds" },
          "format": "time_series",
          "rawSql": "SELECT AVG(CAST(ProcessingTimeMs AS float)) AS value FROM dbo.ACM_RunSummary WHERE Status = 'OK' AND CreatedAt BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "Avg Processing Time",
      "type": "stat"
    },
    {
      "datasource": { "type": "mssql", "uid": "mssql-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 8 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "mssql-ds" },
          "format": "time_series",
          "rawSql": "SELECT ISNULL(SUM(RowsProcessed), 0) AS value FROM dbo.ACM_RunSummary WHERE CreatedAt BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "Total Rows Scored",
      "type": "stat"
    },
    {
      "datasource": { "type": "mssql", "uid": "mssql-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 8 },
      "id": 7,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "mssql-ds" },
          "format": "time_series",
          "rawSql": "SELECT ISNULL(SUM(EpisodesDetected), 0) AS value FROM dbo.ACM_RunSummary WHERE CreatedAt BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
        }
      ],
      "title": "Total Episodes Detected",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 10,
      "title": "RESOURCE UTILIZATION (Prometheus)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Memory (MB)", "drawStyle": "line", "fillOpacity": 20,
            "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2,
            "showPoints": "auto", "spanNulls": 3600000
          },
          "mappings": [], "unit": "decmbytes",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "max by (section) (acm_memory_rss_mb)", "legendFormat": "{{section}}", "refId": "A" }
      ],
      "title": "Memory by Pipeline Phase",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "CPU %", "drawStyle": "line", "fillOpacity": 20,
            "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2,
            "showPoints": "auto", "spanNulls": 3600000
          },
          "mappings": [], "max": 100, "min": 0, "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "id": 12,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "avg by (equipment) (acm_cpu_percent)", "legendFormat": "{{equipment}}", "refId": "A" }
      ],
      "title": "CPU Utilization",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Memory RSS (MB)", "drawStyle": "line", "fillOpacity": 20,
            "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2,
            "showPoints": "auto", "spanNulls": 3600000
          },
          "mappings": [], "unit": "decmbytes",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "id": 13,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "max by (equipment) (acm_memory_rss_mb)", "legendFormat": "{{equipment}}", "refId": "A" }
      ],
      "title": "Memory RSS",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 20,
      "title": "DISTRIBUTED TRACES (Tempo)",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo-ds" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 21 },
      "id": 21,
      "options": {},
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo-ds" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"acm-pipeline\"} | select(span.\"acm.mem_mb\", span.\"acm.duration_s\", span.\"acm.equipment\")",
          "limit": 20,
          "refId": "A"
        }
      ],
      "title": "Trace Search",
      "type": "traces"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 30,
      "title": "LOGS (Loki)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 32 },
      "id": 31,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
