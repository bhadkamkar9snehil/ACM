      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "mssql-ds"
          },
          "format": "table",
          "rawSql": "SELECT TOP 30\n  eq.EquipCode AS Equipment,\n  r.HealthStatus AS Status,\n  r.ScoreRowCount AS RowsProcessed,\n  r.EpisodeCount AS EpisodesDetected,\n  r.DurationSeconds AS DurationSeconds,\n  LEFT(r.ConfigSignature, 12) AS Config,\n  CONVERT(varchar(19), r.StartedAt, 120) AS StartedAt,\n  LEFT(ISNULL(r.ErrorMessage, ''), 60) AS ErrorMessage\nFROM dbo.ACM_Runs r\nJOIN dbo.Equipment eq ON eq.EquipID = r.EquipID\nWHERE r.StartedAt BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY r.StartedAt DESC",
          "refId": "A"
        }
      ],
      "title": "Recent Pipeline Runs",
      "type": "table"
    },
