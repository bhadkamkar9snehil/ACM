    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 55 },
      "id": 50,
      "title": "PIPELINE PHASE TIMING",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "Duration (s)", "drawStyle": "bars", "fillOpacity": 80,
            "gradientMode": "none", "lineWidth": 1, "showPoints": "never"
          },
          "mappings": [], "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 56 },
      "id": 51,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus-ds" }, "expr": "topk(10, acm_stage_duration_seconds_sum)", "legendFormat": "{{stage}}", "refId": "A" }
      ],
      "title": "Stage Duration (Top 10 Stages)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "mssql", "uid": "mssql-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ProcessingTimeMs" }, "properties": [{ "id": "unit", "value": "ms" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "lcd" } }, { "id": "max", "value": 300000 }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 30000 }, { "color": "red", "value": 120000 }] } }] },
          { "matcher": { "id": "byName", "options": "RowsProcessed" }, "properties": [{ "id": "unit", "value": "short" }] }
        ]
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 56 },
      "id": 52,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true, "sortBy": [{ "displayName": "CreatedAt", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "mssql-ds" },
          "format": "table",
          "rawSql": "SELECT TOP 10\n  eq.EquipCode AS Equipment,\n  rs.ProcessingTimeMs,\n  rs.RowsProcessed,\n  CONVERT(varchar(19), rs.CreatedAt, 120) AS CreatedAt\nFROM dbo.ACM_RunSummary rs\nJOIN dbo.Equipments eq ON eq.EquipID = rs.EquipID\nWHERE rs.Status = 'OK' AND rs.CreatedAt BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY rs.CreatedAt DESC",
          "refId": "A"
        }
      ],
      "title": "Recent Run Stats",
      "type": "table"
    },
    {
      "collapsed": false,
