      "targets": [
        { "datasource": { "type": "loki", "uid": "loki-ds" }, "expr": "{app=\"acm\"} |= ``", "queryType": "range", "refId": "A" }
      ],
      "title": "Application Logs",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki-ds" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 32 },
      "id": 32,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki-ds" }, "expr": "{app=\"acm\"} |~ `(ERROR|WARN|error|warn)`", "queryType": "range", "refId": "A" }
      ],
      "title": "Errors & Warnings",
      "type": "logs"
