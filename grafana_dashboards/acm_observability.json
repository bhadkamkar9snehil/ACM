      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 43 },
      "id": 42,
      "options": {},
      "targets": [
        {
          "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope-ds" },
          "profileTypeId": "acm.alloc_space:bytes:bytes::",
          "labelSelector": "{service_name=\"acm-pipeline\"}",
          "queryType": "profile",
          "refId": "A"
        }
      ],
      "title": "Memory Allocation Profile (ACM Pipeline)",
