      },
      "targets": [
        {
          "datasource": { "type": "mssql", "uid": "mssql-ds" },
          "format": "table",
          "rawSql": "SELECT 'ACM_Scores_Wide' AS TableName, COUNT(*) AS TotalRows FROM dbo.ACM_Scores_Wide WHERE CreatedAt BETWEEN $__timeFrom() AND $__timeTo()\nUNION ALL\nSELECT 'ACM_HealthTimeline', COUNT(*) FROM dbo.ACM_HealthTimeline WHERE CreatedAt BETWEEN $__timeFrom() AND $__timeTo()\nUNION ALL\nSELECT 'ACM_RegimeTimeline', COUNT(*) FROM dbo.ACM_RegimeTimeline WHERE CreatedAt BETWEEN $__timeFrom() AND $__timeTo()\nUNION ALL\nSELECT 'ACM_Episodes', COUNT(*) FROM dbo.ACM_Episodes WHERE CreatedAt BETWEEN $__timeFrom() AND $__timeTo()\nUNION ALL\nSELECT 'ACM_RunSummary', COUNT(*) FROM dbo.ACM_RunSummary WHERE CreatedAt BETWEEN $__timeFrom() AND $__timeTo()",
          "refId": "A"
