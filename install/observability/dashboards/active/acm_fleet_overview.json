      "title": "All Equipment \u2014 Current Status",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "mssql",
            "uid": "mssql-ds"
          },
          "rawSql": "SELECT\n  eq.EquipCode AS Equipment,\n  ROUND(h.HealthIndex, 1) AS HealthIndex,\n  h.Zone AS HealthZone,\n  ISNULL(ep.ActiveEpisodes, 0) AS ActiveEpisodes,\n  CONVERT(varchar(19), h.Timestamp, 120) AS LastUpdated\nFROM (\n  SELECT EquipID, HealthIndex, HealthZone AS Zone, Timestamp,\n         ROW_NUMBER() OVER (PARTITION BY EquipID ORDER BY Timestamp DESC) AS rn\n  FROM dbo.ACM_HealthTimeline\n) h\nJOIN dbo.Equipment eq ON eq.EquipID = h.EquipID\nLEFT JOIN (\n  SELECT EquipID, COUNT(*) AS ActiveEpisodes\n  FROM dbo.ACM_Episodes\n  WHERE StartTime >= DATEADD(day, -1, GETUTCDATE())\n  GROUP BY EquipID\n) ep ON ep.EquipID = h.EquipID\nWHERE h.rn = 1 AND eq.Status = 1\nORDER BY h.HealthIndex ASC",
          "format": "table",
          "refId": "A"
        }
      ]
    },
