          },
          "rawSql": "SELECT\n  h.Timestamp AS time,\n  eq.EquipCode AS metric,\n  h.HealthIndex AS value\nFROM dbo.ACM_HealthTimeline h\nJOIN dbo.Equipment eq ON eq.EquipID = h.EquipID\nWHERE h.Timestamp >= DATEADD(day, -7, GETUTCDATE())\n  AND eq.Status = 1\nORDER BY h.Timestamp",
