          },
          "rawSql": "WITH ranked AS (\n  SELECT\n    sh.*,\n    ROW_NUMBER() OVER (\n      PARTITION BY sh.EquipID, sh.SensorName\n      ORDER BY sh.MaxTimestamp DESC, sh.ID DESC\n    ) AS rn\n  FROM dbo.ACM_SensorHotspots sh\n)\nSELECT TOP 30\n  eq.EquipCode AS Equipment,\n  ranked.SensorName,\n  ROUND(ranked.MaxAbsZ, 2) AS MaxAbsZ,\n  ROUND(ranked.LatestAbsZ, 2) AS LatestAbsZ,\n  ranked.AboveWarnCount,\n  ranked.AboveAlertCount\nFROM ranked\nJOIN dbo.Equipment eq ON eq.EquipID = ranked.EquipID\nWHERE ranked.rn = 1\nORDER BY ranked.MaxAbsZ DESC",
          "format": "table",
          "refId": "A"
        }
